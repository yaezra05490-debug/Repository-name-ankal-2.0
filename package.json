{
  "name": "ankal-contacts",
  "productName": "Ankal",
  "version": "2.0.0",
  "description": "Ankal - contacts manager and VCF/Excel/CSV converter",
  "main": "main.js",
  "author": "You",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run-tests.js",
    "smoke": "node tests/smoke.js",
    "build": "npm test && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.local.ankal",
    "productName": "Ankal",
    "files": [
      "main.js",
      "preload.js",
      "app-config.json",
      "src/**/*",
      "!src/YAEZRA/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "ankal-windows.exe"
    },
    "directories": {
      "output": "dist"
    }
  }
}
